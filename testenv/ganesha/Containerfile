# nfs-ganesha test server. Build context is testenv/ (see up.sh).
FROM quay.io/fedora/fedora:latest
RUN dnf install -y nfs-ganesha nfs-ganesha-vfs rpcbind openssl procps-ng iproute util-linux \
 && dnf clean all
COPY fixtures.sh /usr/local/share/nfsc-testenv/fixtures.sh
COPY ganesha/ganesha.conf /etc/ganesha/ganesha.conf
COPY ganesha/entrypoint.sh /usr/local/sbin/ganesha-entrypoint
RUN chmod 0755 /usr/local/sbin/ganesha-entrypoint /usr/local/share/nfsc-testenv/fixtures.sh
EXPOSE 111/tcp 111/udp 2049/tcp 20048/tcp 20048/udp
ENTRYPOINT ["/usr/local/sbin/ganesha-entrypoint"]
