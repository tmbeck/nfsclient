# Kernel nfsd test server. Build context is testenv/ (see up.sh).
FROM docker.io/library/debian:trixie-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      nfs-kernel-server nfs-common rpcbind openssl coreutils procps iproute2 \
 && rm -rf /var/lib/apt/lists/*
COPY fixtures.sh /usr/local/share/nfsc-testenv/fixtures.sh
COPY knfsd/exports /etc/exports
COPY knfsd/entrypoint.sh /usr/local/sbin/knfsd-entrypoint
RUN chmod 0755 /usr/local/sbin/knfsd-entrypoint /usr/local/share/nfsc-testenv/fixtures.sh
EXPOSE 111/tcp 111/udp 2049/tcp 2049/udp 20048/tcp 20048/udp
ENTRYPOINT ["/usr/local/sbin/knfsd-entrypoint"]
